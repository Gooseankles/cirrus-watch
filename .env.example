# --- Server ---
PORT=7070
# Where settings, findings and logs are kept (default ./data and ./logs).
# On App Service set it under /home, e.g. /home/data.
DATA_DIR=
# Signs the login session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=change-me

# --- Sign-in ---
# Quick local admin account (username is always "admin") so you can use the
# dashboard before the Enterprise App below exists, or as a break-glass
# login. Leave blank to disable it once SSO is set up. See README for setup.
DASHBOARD_ADMIN_PASSWORD=
# SSO: a separate Entra ID App Registration/Enterprise App for signing
# people into THIS dashboard (not one of the scan SPNs above). Also defines
# the "Admin" / "User" app roles (and Admin-<key> / User-<key> per customer
# tenant) — see README for the setup steps.
DASHBOARD_AZURE_TENANT_ID=
DASHBOARD_AZURE_CLIENT_ID=
DASHBOARD_AZURE_CLIENT_SECRET=
# Secretless instead of the secret above (App Service): client ID of a
# user-assigned managed identity the app registration trusts through a
# federated credential.
DASHBOARD_FEDERATED_MI_CLIENT_ID=
# Must exactly match a redirect URI registered on that app.
DASHBOARD_REDIRECT_URI=http://localhost:7070/auth/callback

# --- Azure (service principal / app registration) ---
# Shared/default SPN. Any tool without its own override below falls back
# to this one. For least privilege, give each tool its own narrowly-scoped
# SPN instead: set <TOOL_ID>_AZURE_TENANT_ID / _CLIENT_ID / _CLIENT_SECRET,
# using the tool's id in SCREAMING_SNAKE_CASE, e.g. for "orphaned-resources":
#   ORPHANED_RESOURCES_AZURE_TENANT_ID=
#   ORPHANED_RESOURCES_AZURE_CLIENT_ID=
#   ORPHANED_RESOURCES_AZURE_CLIENT_SECRET=
# Tool ids: orphaned-resources, tag-compliance, cost-anomaly, access-review,
# secret-expiry, key-vault, access-packages, access-lookup, role-assignments,
# policy-check, history-storage.
# AZURE_AUTH_TYPE (or <TOOL_ID>_AZURE_AUTH_TYPE): "secret" (default) or
# "managed-identity". With managed identity (App Service) no secret or tenant
# is needed: AZURE_CLIENT_ID is the user-assigned identity's client ID, or
# blank for the app's system-assigned identity. A tool only uses its own
# identity when its <TOOL_ID>_AZURE_CLIENT_ID is set.
AZURE_AUTH_TYPE=secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Customer tenants ---
# Other organizations' tenants to scan (Terraform sets this from `customers`;
# they can also be added in Settings). A JSON list:
#   [{"key":"acme","name":"Acme AS","tenantId":"<guid>","clientId":"<guid>","subscriptionIds":[],"enabled":true}]
# "clientId" is the app registration made in that tenant, with a federated
# credential (issuer and subject below) that trusts the managed identity below.
# Roles: Admin-<key> (read and run) and User-<key> (read). Each tenant's results
# go to the container dashboard-<key>.
DASHBOARD_TENANTS=
# Client ID of the user-assigned managed identity every customer app trusts
# (federated sign-in, no secret), and the issuer and subject (that identity's
# object ID) of the federated credential, shown in Settings.
TENANT_FEDERATED_MI_CLIENT_ID=
TENANT_FEDERATED_ISSUER=
TENANT_FEDERATED_SUBJECT=
# The home tenant's name on its tab (blank = Home), and "off" to scan only the
# customer tenants.
HOME_TENANT_NAME=
HOME_TENANT_SCAN=on

# --- Shared by the scan/lookup tools ---
# Comma-separated subscription IDs to scan. Leave blank (recommended) to scan
# every enabled subscription the identity can see: give it Reader (and Cost
# Management Reader) at a management group and new subscriptions are picked
# up automatically.
AZURE_SUBSCRIPTION_IDS=

# --- Tag compliance ---
AZURE_REQUIRED_TAGS=CostCenter,Owner,Environment

# --- Cost anomaly ---
# Flag a resource group whose spend jumped by at least this % day-over-day.
AZURE_COST_ANOMALY_THRESHOLD_PCT=50

# --- Access review ---
# Flag direct (non-group) Owner/Contributor/User Access Administrator
# assignments on a user older than this many days.
AZURE_ACCESS_REVIEW_STALE_DAYS=365

# --- Expiring app credentials ---
# Flag app registration secrets/certs expiring within this many days. Needs
# Microsoft Graph Application permissions (Application.Read.All,
# User.Read.All) granted with admin consent, in addition to the ARM roles above.
SECRET_EXPIRY_WARN_DAYS=30

# --- Key Vault ---
# Flag secrets, keys and certificates expiring within this many days.
KEYVAULT_EXPIRY_WARN_DAYS=30
# Flag a vault when more identities than this can read its secrets.
KEYVAULT_MAX_READERS=10
# Flag a vault with no reads or writes in this many days (max 90).
KEYVAULT_UNUSED_DAYS=30
# Tag that names a vault's owner (blank = Owner, "none" = do not check).
KEYVAULT_OWNER_TAG=

# --- Access packages (Entra entitlement management) ---
ACCESS_PACKAGE_EXPIRY_WARN_DAYS=14
ACCESS_PACKAGE_STALE_PENDING_DAYS=7
# Flag a package as "unused" once it has zero active assignments and is
# older than this many days (avoids flagging brand-new packages).
ACCESS_PACKAGE_UNUSED_AGE_DAYS=30
