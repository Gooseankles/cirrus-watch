flowchart LR
  dev["Commit to main<br/>(VERSION bumped)"] --> gh["GitHub<br/>Gooseankles/cirrus-watch"]
  gh --> ci["Actions: Docker image<br/>build + push"]
  ci -- "push + cosign sign<br/>(by digest)" --> hub[("Docker Hub<br/>latest, &lt;version&gt;, stable")]
  ci --> tag["Git tag v&lt;version&gt;"]
  promote["Actions: Promote to stable<br/>(by hand, cosign verify first)"] --> hub
  tfrun["terraform apply<br/>image = ...:&lt;version&gt;"] --> web["App Service"]
  hub -- "pull on restart / image change" --> web
  promote -. "OIDC sign-in, az webapp restart<br/>(continuous_deployment)" .-> web
