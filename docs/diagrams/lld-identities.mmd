flowchart TB
  subgraph app["Web app contoso-ops"]
    direction LR
    sys["System-assigned identity<br/>(shared SPN)"]
    uai["User-assigned identity<br/>id-contoso-ops-sso"]
  end
  sso["Sign-in app registration<br/>Cirrus Watch (contoso-ops)"]
  arm["Subscriptions or<br/>management group"]
  msgraph["Microsoft Graph"]
  st["Storage account<br/>containers dashboard,<br/>dashboard-&lt;key&gt;"]
  kv["Key vault"]
  cust["Customer's own app registration<br/>(in their tenant, client secret)"]

  sys -- "Reader,<br/>Cost Management Reader" --> arm
  sys -- "Graph application<br/>permissions" --> msgraph
  sys -- "Storage Blob<br/>Data Contributor" --> st
  sys -- "Key Vault<br/>Secrets Officer" --> kv
  uai -- "federated credential<br/>(token for<br/>api://AzureADTokenExchange)" --> sso
  kv -. "holds the client secret of" .-> cust

  classDef person fill:#fff7ed,stroke:#ea580c,color:#1b2533
  classDef store fill:#ecfdf5,stroke:#059669,color:#1b2533
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#1b2533
  class st,kv store
  class arm,msgraph,cust ext
