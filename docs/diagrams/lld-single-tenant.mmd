flowchart TB
  tf["terraform apply<br/>(no customers)"]
  subgraph rg["rg-contoso-ops"]
    web["Web app contoso-ops<br/>system-assigned identity: scans, storage, vault<br/>id-contoso-ops-sso: sign-in"]
    st[("Storage account<br/>one container: dashboard")]
    kv[("Key vault<br/>secrets typed in Settings")]
  end
  subgraph entra["Entra ID (home tenant)"]
    sso["Sign-in app Cirrus Watch (contoso-ops)<br/>roles Admin, User, &lt;Area&gt;.Read"]
    groups["One security group per role"]
    gperm["Graph application permissions<br/>for the system-assigned identity"]
  end
  scopes["Scan scopes (shared_spn_access)<br/>Reader, Cost Management Reader"]
  tf --> rg
  tf --> entra
  web -- "Storage Blob Data Contributor" --> st
  web -- "Key Vault Secrets Officer" --> kv
  web --> scopes
  groups -- "assigned to the roles" --> sso
  gperm -.-> web
  subgraph later["Later: customers = { acme = … }, apply again"]
    lcont[("container dashboard-acme")]
    lroles["roles and groups<br/>Admin-acme, User-acme, &lt;Area&gt;.Read-acme"]
    lenv["app setting DASHBOARD_TENANTS<br/>(the web app restarts)"]
  end
  st -. "later gets" .-> lcont
  sso -. "later gets" .-> lroles
  web -. "later gets" .-> lenv

  classDef person fill:#fff7ed,stroke:#ea580c,color:#1b2533
  classDef store fill:#ecfdf5,stroke:#059669,color:#1b2533
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#1b2533
  classDef opt stroke-dasharray: 5 5
  class st,kv,lcont store
  class scopes ext
  class lcont,lroles,lenv opt
