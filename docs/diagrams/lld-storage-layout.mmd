flowchart TB
  subgraph hist["History storage: blob containers (STORAGE_ACCOUNT_URL) or folders under DATA_DIR"]
    direction TB
    subgraph home["Home tenant: container dashboard<br/>(or DATA_DIR itself)"]
      direction LR
      h1["findings/&lt;tool&gt;.json<br/>latest result and last error"]
      h2["history/&lt;tool&gt;/index.json<br/>history/&lt;tool&gt;/&lt;ranAt&gt;.json"]
      h3["suppressions/&lt;tool&gt;.json<br/>accepted and snoozed"]
      h4["cost/index.json<br/>cost/&lt;subscription&gt;.json"]
      h1 ~~~ h2
      h3 ~~~ h4
    end
    subgraph cust["Customer &lt;key&gt;: container dashboard-&lt;key&gt;<br/>(or DATA_DIR/tenants/&lt;key&gt;)"]
      c1["The same files,<br/>only that tenant's data"]
    end
    home ~~~ cust
  end
  subgraph data["DATA_DIR (/home/data on App Service)"]
    direction LR
    d1["settings.json<br/>tenant-settings.json<br/>tenants.json"]
    d2["notify.json (links)<br/>notify-queue.json"]
    d3["sessions/<br/>session-secret"]
    d4["monitor.json (48 h of load)<br/>eol-dates.json"]
    d5["logs/runs.jsonl<br/>(activity log)"]
    d6["logs/audit.jsonl<br/>(audit log)"]
    d1 ~~~ d2
    d3 ~~~ d4
    d5 ~~~ d6
  end
  subgraph kv["Key vault (SECRET_VAULT_URL)"]
    k1["dashboard-&lt;kind&gt;-&lt;key&gt;-&lt;hash&gt;<br/>customer secrets, SPN overrides,<br/>notification links"]
  end
  hist ~~~ data
  data ~~~ kv

  classDef person fill:#fff7ed,stroke:#ea580c,color:#1b2533
  classDef store fill:#ecfdf5,stroke:#059669,color:#1b2533
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#1b2533
  class h1,h2,h3,h4,c1,d1,d2,d3,d4,d5,d6,k1 store
