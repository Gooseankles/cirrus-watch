# Copy to terraform.tfvars (gitignored) and fill in.

subscription_id = "00000000-0000-0000-0000-000000000000"
name            = "contoso-azure-tools" # becomes https://contoso-azure-tools.azurewebsites.net
location        = "norwayeast"

# Where the shared SPN (the web app's own identity, used by every tool without
# its own SPN override) gets access. roles defaults to Reader, Cost
# Management Reader and Key Vault Reader (vault item names and expiry dates,
# never secret values), which is all the scans need. The tenant root
# management group's ID is the tenant ID.
shared_spn_access = [
  { scope = "/providers/Microsoft.Management/managementGroups/00000000-0000-0000-0000-000000000000" },
  # Only some subscriptions instead:
  # { scope = "/subscriptions/00000000-0000-0000-0000-000000000000" },
  # Without the Key Vault item checks:
  # { scope = "/subscriptions/<id>", roles = ["Reader", "Cost Management Reader"] },
]

# Scan only these subscriptions (blank = every one the shared SPN can see).
# scan_subscription_ids = ["00000000-0000-0000-0000-000000000000"]

# If you may not create app registrations: set false, apply once, send the
# `terraform output sso_app_request` text to the team, then put the client ID
# they send back here and apply again.
# create_sso_app    = false
# sso_app_client_id = "00000000-0000-0000-0000-000000000000"
# sso_client_secret = ""   # only if they give a secret instead of the federated credential

# Users or groups (object IDs) allowed to sign in (create_sso_app = true only).
admin_principal_ids = ["00000000-0000-0000-0000-000000000000"]
user_principal_ids  = []

# Other organizations' tenants to scan too. Each gets a tab, a storage
# container and the roles Admin-<key> / User-<key>. After apply, send each
# customer their part of `terraform output customer_onboarding`.
# customers = {
#   acme = {
#     name          = "Acme AS"
#     tenant_id     = "00000000-0000-0000-0000-000000000000"
#     client_id     = ""  # app registration made in that tenant; set once it exists
#     admin_members = []  # user object IDs: read and run Acme's scans
#     user_members  = []  # user object IDs: read Acme only
#   }
# }

# A security group per role (needs Entra ID P1/P2); false = assign people directly.
# create_role_groups = true

# Storage reached only through a private endpoint (public access off), web app
# joined to a VNet. Set the two subnet IDs to use an existing VNet instead.
# private_network    = true
# vnet_address_space = ["10.90.0.0/24"]

# Only these public IPs (or ranges) can reach the site; everyone else gets 403
# before the app. Empty = open to the internet (sign-in still required).
# allowed_ip_ranges = ["203.0.113.10", "198.51.100.0/24"]
# Subnets (with the Microsoft.Web service endpoint) that may reach it too.
# allowed_subnet_ids = ["/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>"]

# Break-glass local login; leave blank once SSO works.
# admin_password = "a-long-random-password"

# extra_app_settings = {
#   AZURE_REQUIRED_TAGS  = "CostCenter,Owner,Environment"
#   AUDIT_RETENTION_DAYS = "365" # Admin > Audit log; 30 to 3650 days
# }
