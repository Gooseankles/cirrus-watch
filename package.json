{
  "name": "azure-ops-dashboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Cirrus Watch: self-hosted Azure tenant checks (nightly scans, cost history, access lookup). The app version is in VERSION.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/msal-node": "^7.1.2",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "$@azure/msal-node"
    },
    "body-parser": "^2.4.0"
  }
